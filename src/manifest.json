{
    "manifest_version":  3,
    "name":  "notion-enhancer",
    "version":  "0.11.1",
    "author":  "dragonwocky \u003cthedragonring.bod@gmail.com\u003e (https://dragonwocky.me/)",
    "description":  "Customise the all-in-one productivity workspace Notion.",
    "homepage_url":  "https://notion-enhancer.github.io",
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://*.notion.so/*",
                                                "https://*.notion.site/*",
                                                "https://app.notion.com/*",
                                                "https://*.app.notion.com/*"
                                            ],
                                "js":  [
                                           "extensions/mermaid-replacement/bootstrap.js"
                                       ],
                                "run_at":  "document_start"
                            },
                            {
                                "matches":  [
                                                "https://*.notion.so/*",
                                                "https://*.notion.site/*",
                                                "https://app.notion.com/*",
                                                "https://*.app.notion.com/*"
                                            ],
                                "js":  [
                                           "/init.js"
                                       ]
                            }
                        ],
    "background":  {
                       "service_worker":  "/worker.js"
                   },
    "action":  {

               },
    "icons":  {
                  "16":  "/assets/colour-x16.png",
                  "32":  "/assets/colour-x32.png",
                  "48":  "/assets/colour-x48.png",
                  "128":  "/assets/colour-x128.png",
                  "256":  "/assets/colour-x256.png",
                  "512":  "/assets/colour-x512.png"
              },
    "permissions":  [
                        "tabs",
                        "storage",
                        "userScripts",
                        "clipboardWrite",
                        "unlimitedStorage"
                    ],
    "host_permissions":  [
                             "https://*.notion.so/*",
                             "https://*.notion.site/*",
                             "https://app.notion.com/*",
                             "https://*.app.notion.com/*"
                         ],
    "web_accessible_resources":  [
                                     {
                                         "matches":  [
                                                         "https://*.notion.so/*",
                                                         "https://*.notion.site/*",
                                                         "https://app.notion.com/*",
                                                         "https://*.app.notion.com/*"
                                                     ],
                                         "resources":  [
                                                           "/*"
                                                       ]
                                     }
                                 ],
    "options_ui":  {
                       "page":  "core/menu/index.html",
                       "open_in_tab":  true
                   }
}
